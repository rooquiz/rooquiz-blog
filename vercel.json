{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/:locale(en|zh)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(en|zh)/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
