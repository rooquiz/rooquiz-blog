# 本站规范域名（构建期与客户端都会用到）
NEXT_PUBLIC_SITE_URL=https://blog.rooquiz.com

# Supabase —— blog 专属 project，与 rooquiz-payload 的库无关
SUPABASE_URL=https://<project-ref>.supabase.co
# service role key：构建期同步内容 + 写入 API 使用，绝不能出现在客户端
SUPABASE_SERVICE_ROLE_KEY=

# blog-media（public bucket）的公共 URL 前缀，文章配图从这里取
NEXT_PUBLIC_MEDIA_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/blog-media

# 写入 API 的 Bearer token，自己生成一串足够长的随机值
BLOG_WRITE_TOKEN=

# Vercel Deploy Hook，发布后触发重新构建
VERCEL_DEPLOY_HOOK_URL=

# 每周四自动发文任务用（见 docs/weekly-post-task-prompt.md）
# Unsplash Access Key（Client-ID），封面配图检索用
UNSPLASH_ACCESS_KEY=
# Typefully API Key，排 X 推文用
TYPEFULLY_API_KEY=
